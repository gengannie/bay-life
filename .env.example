# Optional Google OAuth 2.0 Web Client ID for live Google Identity Services One-Tap & OAuth Popup
# When omitted, Bay Life automatically provides an interactive Google Account Chooser & Custom Google Sign-In flow out-of-the-box.
VITE_GOOGLE_CLIENT_ID=

# Optional Firebase Firestore REST Cloud Sync credentials
# When provided, Save Slots (Autosave + Slots 1-3) sync automatically to Firestore under bay_life_users/{googleSub}/saves/{slotId}
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
